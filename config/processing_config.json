{
  "_notes": [
    "Best-practice baseline config for app/process_data_pipeline.py",
    "All settings can be overridden by environment variables (PROCESS_...)"
  ],
  "input": {
    "mode": "raw",
    "files": [
      "structured-data/loadData_20307012.json",
      "structured-data/jsonld_20307012_generated.json"
    ],
    "boilerplate_dir": "output/boilerplate/runtime-snapshots",
    "boilerplate_files": []
  },
  "schema": {
    "enabled": true,
    "file": "config/schema/canonical_event_v1.json",
    "source_boilerplates": {
      "enabled": false,
      "dir": ""
    }
  },
  "preprocessing": {
    "enabled": true,
    "text_fields": [
      "title",
      "description",
      "location_name",
      "category",
      "series",
      "time",
      "start_time",
      "end_time",
      "url"
    ],
    "remove_line_breaks_and_tabs": true,
    "remove_html_tags": true,
    "remove_html_entities": true,
    "trim_whitespace": true
  },
  "replacements": {
    "enabled": true,
    "rules": [
      {
        "field": "location_name",
        "search": "Ort siehe Beschreibung",
        "replace": "Kommunales Kino",
        "mode": "exact",
        "case_sensitive": false
      }
    ]
  },
  "export": {
    "enabled": true,
    "_notes_formats": [
      "Currently only supports CSV and XML export, but can be extended to other formats (e.g. JSON, Excel, etc.)",
      "The export format(s) can be configured via the 'formats' setting, which can be overridden by the PROCESS_FORMATS environment variable (comma-separated list, e.g. 'csv,xml')"
    ],
    "formats": [
      "csv",
      "xml"
    ],
    "output_dir": "output",
    "encoding": "utf-8",
    "line_ending": "\n",
    "rows_per_file": {
      "enabled": false,
      "value": 1000
    },
    "filename_template": "{source}_{format}_{timestamp}{_part{part}}.{ext}",
    "filename_context": {
      "category": "calendar"
    },
    "date_input_formats": [
      "%Y-%m-%d",
      "%d.%m.%Y"
    ],
    "date_output_format": "%Y-%m-%d",
    "_notes_schema_fields": [
      "When export.fields is empty, field order is read from schema boilerplate.",
      "When export.field_mappings is empty, labels are read from schema boilerplate."
    ],
    "fields": [],
    "field_mappings": {},
    "csv": {
      "delimiter": ";",
      "quotechar": "\"",
      "escapechar": "\\",
      "quoting": "minimal",
      "doublequote": false
    },
    "xml": {
      "root_tag": "events",
      "item_tag": "event",
      "include_declaration": true
    }
  }
}
